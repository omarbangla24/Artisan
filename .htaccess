# Clean URLs — serve .php files without the extension
RewriteEngine On

# Use index.php as the directory index
DirectoryIndex index.php

# Leave the admin panel to its own rules (it keeps normal .php URLs)
RewriteRule ^admin/ - [L]

# 1) If someone requests /page.php or /page.html directly, 301 to the clean /page
RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.(php|html)[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2) Internally map the clean /page to /page.php (only when that file exists)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Do not expose dotfiles directly
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
